{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)-12s %(executor)-10s %(levelname)-8s %(message)s",
            "datefmt":"%d %b %Y %H:%M:%S"
        },
        "json": {
            "()": "log_starter.JsonFormatter"
        },
        "timer": {
          "()": "log_starter.JsonTimerFormatter"
        }
    },
    "filters": {
        "event_only": {
            "()": "log_starter.EventOnlyFilter"
        },
        "timer_only": {
          "()": "log_starter.TimerOnlyFilter"
        },
        "no_timer": {
          "()": "log_starter.NoTimerFilter"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "formatter": "simple",
            "stream": "ext://sys.stdout",
            "level": "DEBUG",
            "filters": ["no_timer"]
        },
        "file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "filename": "INSERT ACTUAL PATH",
            "maxBytes": 100000,
            "backupCount": 3,
            "filters": ["no_timer"]
        },
        "json_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "json",
            "filters": ["event_only"],
            "filename": "INSERT JSON PATH",
            "maxBytes": 200000,
            "backupCount": 3
        },
        "timer_file": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "timer",
            "filters": ["timer_only"],
            "filename": "INSERT JSON PATH",
            "maxBytes": 500000,
            "backupCount": 3
        },
        "sqlite_timer": {
            "()": "log_starter.SQLiteHandler",
            "level": "DEBUG",
            "filters": ["timer_only"]
        }
    },
    "loggers": {
        "scraper": {
            "level": "DEBUG",
            "handlers": ["stdout", "file","json_file", "timer_file","sqlite_timer"],
            "propagate": false
        }
    }
}
